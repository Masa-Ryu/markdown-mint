{
  "name": "markdown-mint",
  "displayName": "Markdown Mint",
  "description": "A visual Markdown editor for VS Code with rich table editing, GitHub/GitLab profiles, Mermaid, math, and auto-formatting.",
  "version": "0.0.30",
  "publisher": "masa-ryu",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Masa-Ryu/markdown-mint.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "markdown editor",
    "wysiwyg",
    "visual editor",
    "rich text",
    "markdown preview",
    "markdown table",
    "markdown formatter",
    "github",
    "gitlab",
    "gfm",
    "commonmark",
    "mermaid",
    "latex"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCustomEditor:markdownMint.editor",
    "onCommand:markdownMint.openPreview",
    "onCommand:markdownMint.openSource",
    "onCommand:markdownMint.formatDocument",
    "onCommand:markdownMint.openInEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownMint.openPreview",
        "title": "Markdown Mint: Open Dedicated Preview",
        "enablement": "resourceLangId == markdown"
      },
      {
        "command": "markdownMint.openSource",
        "title": "Markdown Mint: Open Source",
        "enablement": "resourceLangId == markdown"
      },
      {
        "command": "markdownMint.formatDocument",
        "title": "Markdown Mint: Format Document",
        "enablement": "resourceLangId == markdown"
      },
      {
        "command": "markdownMint.openInEditor",
        "title": "Markdown Mint: Open in Markdown Mint",
        "enablement": "resourceLangId == markdown"
      }
    ],
    "customEditors": [
      {
        "viewType": "markdownMint.editor",
        "displayName": "Markdown Mint",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdown"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Markdown Mint",
      "properties": {
        "markdownMint.profile": {
          "type": "string",
          "enum": [
            "commonmark",
            "github",
            "gitlab"
          ],
          "enumDescriptions": [
            "Portable CommonMark behavior.",
            "GitHub Flavored Markdown behavior.",
            "GitLab Flavored Markdown behavior."
          ],
          "default": "github",
          "description": "Markdown profile used by the structured editor and dedicated preview.",
          "scope": "resource"
        },
        "markdownMint.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Format Markdown safely before saving.",
          "scope": "resource"
        },
        "markdownMint.prettierOptions": {
          "type": "object",
          "default": {
            "printWidth": 80,
            "proseWrap": "preserve"
          },
          "description": "Additional Prettier options passed to the Markdown formatter.",
          "scope": "resource"
        }
      }
    },
    "markdown.previewStyles": [
      "./media/document.css",
      "./dist/katex/katex.css"
    ],
    "markdown.previewScripts": [
      "./dist/mermaid.js"
    ],
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:extension": "node scripts/build.mjs --extension-only",
    "build:webview": "node scripts/build.mjs --webview-only",
    "clean": "node scripts/clean.mjs",
    "compile": "tsc --noEmit",
    "dev": "node scripts/build.mjs --watch",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.json\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.json\" \"docs/**/*.md\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:browser:spacing": "npm run build:webview && node tests/browser/spacing.test.mjs",
    "test:watch": "vitest",
    "test:extension": "npm run compile && npm run build && node scripts/test-extension.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "package": "npm run build && vsce package --no-dependencies && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.17.2",
    "prettier": "^3.6.2",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.2",
    "prosemirror-model": "^1.25.3",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.1",
    "prosemirror-transform": "^1.10.4",
    "prosemirror-view": "^1.41.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
