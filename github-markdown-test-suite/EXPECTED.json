  "clipboard_scenarios": [
    {
      "id": "EDITOR-01",
      "table": "GH-TABLE-08",
      "indexing": "1-based data rows, excluding header",
      "source": {
        "first_row": 5,
        "last_row": 15,
        "first_column": 3,
        "last_column": 6
      },
      "destination": {
        "first_row": 25,
        "first_column": 8
      },
      "expected_destination_last_row": 35,
      "expected_destination_last_column": 11,
      "expected_cells": 44,
      "undo": "restore original coordinates in one operation"
    },
    {
      "id": "EDITOR-02",
      "table": "GH-TABLE-08",
      "source": {
        "first_row": 5,
        "last_row": 15,
        "first_column": 3,
        "last_column": 6
      },
      "destination": {
        "first_row": 38,
        "first_column": 10
      },
      "expected_if_auto_expand_enabled": {
        "data_rows": 48,
        "columns": 13
      },
      "otherwise": "explicit conflict/size warning; do not silently truncate"
    }
  ],
  "boundary_expectations": {
    "NEG-01": "not a table",
    "NEG-02": "display fills missing body cells and ignores excess; raw source preservation is a separate requirement",
    "NEG-03": "unescaped pipe still separates cells inside code syntax",
    "NEG-08": "nested alerts not a documented supported case",
    "unclosed-fence": "code continues to EOF"
  }
